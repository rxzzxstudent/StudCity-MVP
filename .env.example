# ==========================================
# NOOKI ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Telegram Bot (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-nooki-domain.vercel.app

# 2. Supabase Analytics (from supabase.com Project Settings ➔ API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. AES-256 Data Encryption Key (32-byte / 64-character hex key)
# Сгенерировать новый: openssl rand -hex 32
ANALYTICS_ENCRYPTION_KEY=e8f93a1058b4562c90df1123456789abcdef0123456789abcdef0123456789ab

# 4. Google Sheets Real-time Sync Webhook (из Google Apps Script Deploy URL)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
